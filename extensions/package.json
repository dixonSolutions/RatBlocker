{
  "name": "ratblocker-extensions",
  "version": "0.1.8",
  "private": true,
  "description": "RatBlocker browser extensions for Chromium and Firefox.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node build.mjs",
    "build:chromium": "node build.mjs chromium",
    "build:firefox": "node build.mjs firefox",
    "test": "node --test \"tests/*.test.mjs\"",
    "install:local": "node install.mjs",
    "uninstall:local": "node install.mjs --uninstall",
    "update:local": "node install.mjs --update",
    "serve": "node serve.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0",
    "@types/chrome": "^0.0.300",
    "@types/firefox-webext-browser": "^120.0.4"
  }
}
