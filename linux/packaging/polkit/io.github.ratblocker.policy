<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>RatBlocker</vendor>
  <vendor_url>https://github.com/ratblocker/ratblocker</vendor_url>

  <!--
    Turning protection on and off is a routine, reversible thing a person does
    at their own desk, so an active local session is enough. Changing what is
    filtered affects every account on the machine, so that needs admin rights.

    Every action carries an `owner` annotation naming the daemon's account.
    Polkit only lets root, or an action's declared owner, ask about a subject
    belonging to a different identity — and the daemon is deliberately not
    root, so without this it could not check the caller at all.
  -->
  <action id="io.github.ratblocker.toggle">
    <description>Turn RatBlocker protection on or off</description>
    <message>Authentication is required to change RatBlocker protection</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.owner">unix-user:ratblocker</annotate>
  </action>

  <action id="io.github.ratblocker.configure">
    <description>Change RatBlocker filtering configuration</description>
    <message>Authentication is required to change RatBlocker settings for this system</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.owner">unix-user:ratblocker</annotate>
  </action>

  <action id="io.github.ratblocker.update">
    <description>Update RatBlocker filter lists</description>
    <message>Authentication is required to update RatBlocker filter lists</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.owner">unix-user:ratblocker</annotate>
  </action>
</policyconfig>
